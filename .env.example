# Copia este archivo como ".env" y ajusta los valores.
# Front: console.log(import.meta.env.VARIABLE)   ·   Back: os.getenv('VARIABLE')

# ---------- Back-End ----------
# Local SIN esta variable = usa un archivo SQLite (local.sqlite) y no necesitas instalar nada.
# Con Supabase: pega aquí la cadena del "Session pooler".
#DATABASE_URL=postgresql://postgres.xxxx:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
FLASK_APP_KEY="cambia-esta-llave"
JWT_SECRET_KEY="dev-only-cambia-esta-llave-larga-de-mas-de-32-caracteres"
FLASK_APP=src/app.py
FLASK_DEBUG=1
DEBUG=TRUE

# Super admin que se crea con: pipenv run flask seed
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=cambia-esta-clave
SUPERADMIN_NAME="Alejandro Sánchez"

# ---------- Front-End ----------
VITE_BASENAME=/
# Déjala vacía: en local Vite reenvía /api al puerto 3001 y en Render todo vive en el mismo dominio.
#VITE_BACKEND_URL=
